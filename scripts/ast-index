#!/bin/sh
# Keep both the executable and generated index in the ignored local runtime.
set -eu
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"
export AST_INDEX_CACHE_DIR="$project_root/.local-runtime/ast-index/cache"
exec "$project_root/.local-runtime/ast-index/ast-index" "$@"
